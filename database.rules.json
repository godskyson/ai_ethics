{
  "rules": {
    "exam": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'king03603@gmail.com'"
    },
    "roster": {
      ".read": "auth != null && auth.token.email === 'king03603@gmail.com'",
      ".write": "auth != null && auth.token.email === 'king03603@gmail.com'",
      "$sid": {
        ".read": "auth != null && root.child('claims/' + auth.uid + '/sid').val() === $sid",
        ".validate": "$sid.matches(/^[1-3](0[1-9]|1[0-9])(0[1-9]|[1-4][0-9])$/) && newData.hasChild('classId')"
      }
    },
    "pins": {
      ".write": "auth != null && auth.token.email === 'king03603@gmail.com'",
      "$sid": {
        ".write": "auth != null && newData.exists() && root.child('claims/' + auth.uid + '/sid').val() === $sid && root.child('claims/' + auth.uid + '/hash').val() === data.child('hash').val()",
        ".validate": "newData.hasChildren(['hash', 'mustChange']) && newData.child('hash').isString() && newData.child('hash').val().length === 64 && newData.child('mustChange').isBoolean() && newData.parent().parent().child('roster/' + $sid).exists()",
        "mustChange": {
          ".read": "auth != null && root.child('claims/' + auth.uid + '/sid').val() === $sid"
        }
      }
    },
    "claims": {
      ".read": "auth != null && auth.token.email === 'king03603@gmail.com'",
      ".write": "auth != null && auth.token.email === 'king03603@gmail.com'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['sid', 'hash']) && newData.child('sid').isString() && newData.parent().parent().child('pins/' + newData.child('sid').val() + '/hash').val() === newData.child('hash').val()"
      }
    },
    "progress": {
      ".read": "auth != null && auth.token.email === 'king03603@gmail.com'",
      ".write": "auth != null && auth.token.email === 'king03603@gmail.com'",
      "$sid": {
        ".read": "auth != null && root.child('claims/' + auth.uid + '/sid').val() === $sid",
        ".write": "auth != null && root.child('claims/' + auth.uid + '/sid').val() === $sid && root.child('claims/' + auth.uid + '/hash').val() === root.child('pins/' + $sid + '/hash').val() && root.child('exam/classes/' + root.child('roster/' + $sid + '/classId').val() + '/status').val() === 'running'",
        "modelName": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "dataset": {
          ".validate": "newData.hasChildren()",
          "$i": {
            ".validate": "$i.matches(/^[0-5]$/)",
            "label": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "texts": {
              "$j": { ".validate": "$j.matches(/^([0-9]|[12][0-9])$/) && newData.isString() && newData.val().length <= 100" }
            }
          }
        },
        "tests": {
          "$i": {
            ".validate": "$i.matches(/^[0-2]$/)",
            "text": { ".validate": "newData.isString() && newData.val().length <= 100" }
          }
        },
        "ethics": {
          "$k": { ".validate": "($k === 'privacy' || $k === 'bias' || $k === 'judgment') && newData.isString() && newData.val().length <= 1000" }
        }
      }
    },
    "presence": {
      ".read": "auth != null && auth.token.email === 'king03603@gmail.com'",
      ".write": "auth != null && auth.token.email === 'king03603@gmail.com'",
      "$sid": {
        ".read": "auth != null && root.child('claims/' + auth.uid + '/sid').val() === $sid",
        ".write": "auth != null && root.child('claims/' + auth.uid + '/sid').val() === $sid && root.child('claims/' + auth.uid + '/hash').val() === root.child('pins/' + $sid + '/hash').val()"
      }
    },
    "results": {
      ".read": "auth != null && auth.token.email === 'king03603@gmail.com'",
      ".write": "auth != null && auth.token.email === 'king03603@gmail.com'"
    },
    "teacherLog": {
      ".read": "auth != null && auth.token.email === 'king03603@gmail.com'",
      ".write": "auth != null && auth.token.email === 'king03603@gmail.com'",
      "$id": {
        ".validate": "newData.hasChildren(['ip', 'at']) && newData.child('ip').isString() && newData.child('ip').val().length <= 64"
      }
    }
  }
}
